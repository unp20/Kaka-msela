          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === "accepted") {
            deferredPrompt = null;
          }
        } else {
          window.location.href = "pages/pwa-guide.html";
        }
      });
    }

